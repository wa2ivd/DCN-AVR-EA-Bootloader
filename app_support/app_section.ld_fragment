/*
 * Linker fragment for the application side, if you prefer a custom
 * linker script over the `-Wl,--section-start=.text=0x0800` command-line
 * flag.
 *
 * For most projects the command-line flag is simpler — this file is here
 * only for builds that already maintain a custom .ld and want everything
 * in one place.
 *
 * If you DO use a custom .ld, derive it from the avr-libc default for
 * your specific AVR EA part and replace the MEMORY block's "text" region
 * with the following:
 *
 *     text   (rx)   : ORIGIN = 0x1000,    LENGTH = 64K - 4K - 2
 *
 * The "- 2" reserves the last two bytes of flash for the CRC trailer.
 * Adjust LENGTH if BL_FUSE_BOOTSIZE differs from the default 0x08
 * (i.e. the BOOT section is not 2 KB), or if you chose a different
 * BL_APP_CRC_ADDR.
 */

/*
 * Optional symbol-only fragment you can include at the END of a normal
 * link, after the default sections are placed, to enforce that nothing
 * outside the app overlaps the trailer slot:
 */

/*
 * PROVIDE(__app_start__   = 0x1000);
 * PROVIDE(__app_crc_addr__ = 0xFFFE);
 *
 * ASSERT(__app_crc_addr__ - __app_start__ > 0,
 *        "CRC trailer address must lie above APP_START")
 */
